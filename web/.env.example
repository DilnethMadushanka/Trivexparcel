# ---------- Firebase web app (Firebase console > Project settings > Your apps) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (Project settings > Service accounts > Generate new private key) ----------
# Paste the whole JSON file, base64-encoded:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------- App ----------
# Comma-separated Google emails that become admins on first sign-in
ADMIN_EMAILS=you@gmail.com
# Long random string. Phone numbers are stored only as HMAC-SHA256 with this secret.
# Generate one with:  openssl rand -hex 32   (never change it after launch)
HASH_SECRET=
# Public URL of the site, used for payment return links
NEXT_PUBLIC_SITE_URL=https://hariyata.vercel.app

# ---------- Manual payments shown on the Billing page ----------
PAY_BANK_DETAILS=Trivex IT, Commercial Bank, Acc 0000000000, Colombo branch
PAY_EZCASH_NUMBER=077 000 0000

# ---------- Dialog Genie IPG (leave empty until your merchant account is approved) ----------
# Fill these from the API documentation and keys Genie Business gives you.
GENIE_API_BASE=
GENIE_API_KEY=
GENIE_WEBHOOK_SECRET=
